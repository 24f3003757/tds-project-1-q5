# Copy to .env, fill in, then: set -a; source .env; set +a
# The same names go into Render's Environment tab. Never commit the real .env.

# --- required ---------------------------------------------------------------
# @BotFather -> /newbot (or /token for an existing bot)
TELEGRAM_BOT_TOKEN=

# The LLM key. The name is historic and provider agnostic. With the defaults
# below this is an Anthropic key from https://console.anthropic.com -> API keys
OPENROUTER_TOKEN=sk-ant-

# Your deployed base URL, no trailing slash. Used to build log_url when GitHub
# publishing is off. If this is wrong, every reply carries a dead log_url.
PUBLIC_BASE_URL=https://tds-project-1-q5-1.onrender.com

# --- LLM, all have working defaults ------------------------------------------
# Trailing slash required: the OpenAI SDK appends "chat/completions" to it.
LLM_BASE_URL=https://api.anthropic.com/v1/
# Strong model: drives retrieval questions (long tool loops over PDFs).
MODEL=claude-sonnet-5
# Cheap model: drives inline arithmetic, which is most of the graded set.
CHEAP_MODEL=claude-haiku-4-5-20251001
# Every name here must exist on LLM_BASE_URL or each call 404s once per name.
MODEL_CHAIN=claude-haiku-4-5-20251001,claude-sonnet-5
MAX_TOKENS=1200

# --- strongly recommended ----------------------------------------------------
# https://tavily.com free tier, no card. Without it web_search scrapes
# DuckDuckGo, which datacenter IPs are routinely blocked from, and every
# retrieval answer becomes a guess.
TAVILY_TOKEN=

# Setting both moves log_url to raw.githubusercontent, which survives the host
# restarting and wiping its disk. Fine grained PAT, this repo only,
# Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=24f3003757/tds-project-1-q5
GITHUB_BRANCH=main
GITHUB_LOG_PATH=run.jsonl

# --- optional ----------------------------------------------------------------
# Documents whose newest referenced year is below this are flagged as archived.
DATA_RECENCY_FLOOR=2019
LOG_PATH=run.jsonl
